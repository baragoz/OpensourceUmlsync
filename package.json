{
  "name": "umlsync",
  "version": "0.0.1",
  "description": "A UMLSync Viewer and Editor",
  "type": "module",
  "main": "./dist/editor/UMLSync.editor.cjs.js",
  "module": "./dist/editor/UMLSync.editor.es.js",
  "types": "./dist/editor/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/editor/UMLSync.editor.es.js",
      "require": "./dist/editor/UMLSync.editor.cjs.js"
    },
    "./viewer": {
      "import": "./dist/viewer/UMLSync.viewer.es.js",
      "require": "./dist/viewer/UMLSync.viewer.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.editor.js",
    "build:editor": "vite build --config vite.config.editor.js",
    "build:viewer": "vite build --config vite.config.viewer.js",
    "build": "npm run build:editor && npm run build:viewer",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-url": "^8.0.2",
    "@types/node": "^22.10.7",
    "clang-format": "^1.8.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-spritesmith": "^0.0.3",
    "typescript": "^5.7.3",
    "vite": "^4.5.9",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-spritesmith": "^0.1.1"
  },
  "files": [
    "build",
    "examples/",
    "LICENSE",
    "package.json",
    "README.md",
    "src"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/umlsynco/umlsync.git"
  },
  "license": "MIT"
}
